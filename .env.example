# Base URL of the Higgsfield platform API (server-side only).
HF_API_BASE_URL=
# Set to 1 on a production build to fail while sample media (/presets/*) is still referenced.
# HF_FAIL_ON_PLACEHOLDERS=1
# Set to 1 to run against an in-memory fake platform: no key, no network, no credits.
# Put [nsfw] [fail] [empty] [slow] [ratelimit] [credits] [badkey] or [500] in a prompt to see that outcome.
# HF_MOCK=1
# Set to 1 to log request and response bodies on the server (includes prompts).
# HF_DEBUG=1
# Optional: any long random string. Encrypts the saved API key inside its cookie.
# HF_COOKIE_SECRET=
# Optional: space-separated hosts (e.g. "cdn.example.com *.example-storage.com") that
# images, video and uploads may load from. Unset = any https host.
# HF_MEDIA_HOSTS=
